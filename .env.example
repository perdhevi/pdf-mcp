# Copy to .env and adjust. Every variable is optional; defaults shown.

# --- Paths -------------------------------------------------------------------
# Registry DB lives here; inbox defaults to <data_dir>/inbox
PDF_MCP_DATA_DIR=./data
# One sub-folder per customer code: inbox/ACME/..., inbox/GLOBEX/...
# PDF_MCP_INBOX_DIR=D:/Documents/customers
# Docker only: host folder mounted as the inbox (default ./data/inbox). Read by docker compose, not by pdf-mcp.
# HOST_INBOX_DIR=D:/Documents/customers

# --- Qdrant ------------------------------------------------------------------
PDF_MCP_QDRANT_URL=http://localhost:6333
# PDF_MCP_QDRANT_API_KEY=
# Embedded on-disk Qdrant instead of a server (no Docker; one process at a time):
# PDF_MCP_QDRANT_PATH=./data/qdrant

# --- Models (provider per role: ollama | openai) ------------------------------
PDF_MCP_OLLAMA_BASE_URL=http://localhost:11434
PDF_MCP_EMBED_PROVIDER=ollama
PDF_MCP_EMBED_MODEL=bge-m3
PDF_MCP_LLM_PROVIDER=ollama
PDF_MCP_LLM_MODEL=qwen3-vl:8b
PDF_MCP_VISION_PROVIDER=ollama
PDF_MCP_VISION_MODEL=qwen3-vl:8b
# Uncomment to send think=false (faster answers from Ollama thinking models)
# PDF_MCP_OLLAMA_THINK=false

# Any OpenAI-compatible API (OpenAI, Azure, OpenRouter, LM Studio, vLLM):
# PDF_MCP_OPENAI_BASE_URL=https://api.openai.com/v1
# PDF_MCP_OPENAI_API_KEY=sk-...
# e.g. PDF_MCP_EMBED_PROVIDER=openai + PDF_MCP_EMBED_MODEL=text-embedding-3-small

# --- Extraction --------------------------------------------------------------
PDF_MCP_OCR_ENABLED=true
# tesseract | vision (send scanned pages to the vision model instead)
PDF_MCP_OCR_ENGINE=tesseract
# eng+ind needs the Indonesian traineddata installed
PDF_MCP_OCR_LANG=eng
# Windows: path to tesseract.exe if it is not on PATH
# PDF_MCP_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
PDF_MCP_VISION_ENABLED=true
PDF_MCP_VISION_MAX_IMAGES_PER_DOC=40
# Pages with >= this many vector drawing ops (charts drawn as paths) go to the vision model. 0 = off.
PDF_MCP_VISION_VECTOR_MIN_DRAWINGS=12

# --- Retrieval ---------------------------------------------------------------
PDF_MCP_CHUNK_SIZE=1200
PDF_MCP_CHUNK_OVERLAP=200

# --- Cross-customer access ----------------------------------------------------
# Expose find_reference_all_customers (exact invoice/PO lookup across ALL customers)
PDF_MCP_ALLOW_GLOBAL_SEARCH=false

# --- Server ------------------------------------------------------------------
PDF_MCP_HTTP_HOST=127.0.0.1
PDF_MCP_HTTP_PORT=8765
# Base of file links in results (set when clients reach the server by another name)
# PDF_MCP_PUBLIC_BASE_URL=http://my-server:8765
PDF_MCP_WATCH_ENABLED=true
# Needed when the inbox is a Docker bind mount on Windows
PDF_MCP_WATCH_POLLING=false
PDF_MCP_LOG_LEVEL=INFO
